# ===== LLM（留空则自动使用确定性离线设计器）=====
LLM_PROVIDER=openai          # openai | deepseek | ollama | offline
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 兼容 OpenAI 协议的自定义端点（DeepSeek / Ollama 等）
# 例：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=你的deepseek密钥
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# ===== Embedding / RAG =====
# hash: 无需联网/下载，基于字符 n-gram 哈希（离线演示用）
# openai: 真实语义向量（需要 OPENAI_API_KEY）
# local: sentence-transformers 多语言模型（较重）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
TOP_K_FURNITURE=3
